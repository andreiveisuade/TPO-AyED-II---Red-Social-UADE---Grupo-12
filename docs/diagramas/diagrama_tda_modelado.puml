@startuml Modelado TDA del Sistema
!theme plain
left to right direction
skinparam backgroundColor #FEFEFE
skinparam classAttributeIconSize 0
skinparam defaultFontSize 10
skinparam classFontSize 12
skinparam stereotypeFontSize 9
skinparam noteFontSize 9

title **Diagrama de Modelado y TDAs**\nArquitectura completa del sistema

' ==========================================
' CAPA DE VISTA (UI consola)
' ==========================================
package "vista" #E3F2FD {

    class Main <<entry point>> {
        + {static} main(String[]): void
        - {static} seleccionarBaseDeDatos(): String
    }

    class Menu {
        - gestor: GestorClientes
        - menuHistorial: MenuHistorial
        - menuSolicitudes: MenuSolicitudes
        __
        + iniciar(): void
    }

    class MenuSolicitudes {
        + mostrar(): void
        __
        <color:teal>Iter 3: amistades, BFS, matrices</color>
    }

    class MenuHistorial {
        + mostrar(): void
    }

    Main ..> Menu : crea
    Menu "1" *-- "1" MenuSolicitudes
    Menu "1" *-- "1" MenuHistorial
}

' ==========================================
' ENTIDADES DE DOMINIO
' ==========================================
package "modelo" #FFF3E0 {

    class Sesion <<Singleton>> {
        - {static} instancia: Sesion
        - usuarioActual: Cliente
        - historial: HistorialAcciones
        __
        + {static} getInstancia(): Sesion
        + iniciarSesion(Cliente): void
        + cerrarSesion(): void
    }

    class Cliente {
        - id: int
        - nombre: String
        - scoring: int
        - siguiendo: Diccionario<Integer, Boolean>
        - seguidores: Diccionario<Integer, Boolean>
        - amistades: Diccionario<Integer, Boolean>
        - solicitudesPendientes: Cola<SolicitudSeguimiento>
        __
        + seguir(int) / dejarDeSeguir(int)
        + agregarAmistad(int) / eliminarAmistad(int)
        + esAmigoDE(int) / sigueA(int)
        + obtenerAmigos(): int[]
    }

    class Accion {
        - tipo: TipoAccion
        - datos: String[]
        - timestamp: LocalDateTime
    }

    enum TipoAccion {
        SEGUIR
        DEJAR_DE_SEGUIR
    }

    class SolicitudSeguimiento <<Value Object>> {
        - solicitante: String
        - objetivo: String
    }

    Accion "1" --> "1" TipoAccion : tipo
    Sesion "1" *-- "0..1" Cliente : usuarioActual
    Cliente "1" --> "0..*" SolicitudSeguimiento : encola
}

' ==========================================
' TDAs (Tipos Abstractos de Datos)
' ==========================================
package "tda" #F3E5F5 {

    class "Pila<T>" as Pila <<TDA>> {
        - tope: NodoPila<T>
        ==
        + apilar(T) / desapilar(): T
        + verTope(): T
        ==
        O(1) todas | <color:blue>LIFO</color>
    }

    class "Cola<T>" as Cola <<TDA>> {
        - frente: NodoCola<T>
        - fin: NodoCola<T>
        ==
        + encolar(T) / desencolar(): T
        + verFrente(): T
        ==
        O(1) todas | <color:green>FIFO</color>
    }

    class "Diccionario<K,V>" as Diccionario <<TDA>> {
        - tabla: NodoDiccionario<K,V>[]
        ==
        + insertar(K, V) / obtener(K): V
        + contiene(K) / eliminar(K): V
        + obtenerClaves(): String[]
        ==
        O(1) amortizado | <color:purple>Hash Table</color>
    }

    class "ABB<K,V>" as ABB <<TDA>> {
        - raiz: NodoABB<K,V>
        ==
        + insertar(K, V) / buscar(K): Object[]
        + eliminar(K, V): boolean
        + obtenerEnNivel(int): Object[]
        + representarArbol(): String
        ==
        O(log N) | <color:red>BST</color>
    }

    class Conjunto <<TDA>> {
        - elementos: Diccionario<String, Boolean>
        ==
        + agregar(String) / contiene(String)
        ==
        O(1) | <color:orange>Set</color>
    }

    ' Nodos internos (simplificados)
    class NodoPila<T> <<internal>> {
        dato: T
        siguiente: NodoPila
    }
    class NodoCola<T> <<internal>> {
        dato: T
        siguiente: NodoCola
    }
    class NodoDiccionario<K,V> <<internal>> {
        clave: K, valor: V
        siguiente: NodoDiccionario
    }
    class NodoABB<K,V> <<internal>> {
        clave: K, valor: V
        izq: NodoABB, der: NodoABB
    }

    Pila "1" *-- "0..1" NodoPila : tope
    Cola "1" *-- "0..1" NodoCola : frente/fin
    Diccionario "1" *-- "0..*" NodoDiccionario : tabla[]
    ABB "1" *-- "0..1" NodoABB : raiz
    Conjunto "1" --> "1" Diccionario : "delega\n<String, Boolean>"
}

' ==========================================
' CAPA DE SERVICIO
' ==========================================
package "servicio" #E8F5E9 {

    class GestorClientes <<Facade>> {
        - clientes: Diccionario<Integer, Cliente>
        - indices: IndiceClientes
        - gestorRelaciones: GestorRelaciones
        - persistencia: PersistenciaClientes
        ==
        + agregarCliente() / eliminarCliente()
        + buscarPorId() / buscarPorNombre() / buscarPorScoring()
        __
        <color:blue>Delega relaciones a GestorRelaciones:</color>
        + seguir() / dejarDeSeguir()
        + agregarAmistad() / eliminarAmistad()
        + calcularDistancia(int, int): int
        __
        + deshacer(): Accion
    }

    class IndiceClientes {
        - indiceScoring: ABB<Integer, Cola<Cliente>>
        - indiceNombre: Diccionario<String, Cola<Cliente>>
        ==
        + buscarPorNombre(): Cliente[]
        + buscarPorScoring(): Cliente[]
        __
        <color:gray>Scoring: lazy loading</color>
    }

    class GestorRelaciones {
        - clientes: Diccionario<Integer, Cliente>
        ==
        <color:blue>Seguimientos (grafo dirigido):</color>
        + seguir() / dejarDeSeguir()
        + construirArbolRelaciones(): ABB
        __
        <color:teal>Iter 3 - BFS:</color>
        + calcularDistancia(int, int): int
        __
        <color:teal>Iter 3 - Amistades (no dirigido):</color>
        + agregarAmistad() / eliminarAmistad()
        + sonAmigos() / obtenerAmigos()
        __
        <color:gray>BFS: Cola + Diccionario visitados</color>
    }

    class PersistenciaClientes {
        + cargarDesdeArchivo(): Diccionario
        + guardarCambios(Diccionario): void
        __
        <color:gray>Carga Inicial / Guardado Final</color>
        <color:gray>Capacidad dinamica: alfa = 0.75</color>
    }

    class HistorialAcciones {
        - historial: Pila<Accion>
        ==
        + registrar(Accion): void
        + extraerUltima(): Accion
    }
}

' ==========================================
' RELACIONES CON CARDINALIDADES
' ==========================================

' Vista -> Servicio
Menu "1" --> "1" GestorClientes : gestor
MenuSolicitudes "1" --> "1" GestorClientes : gestor
MenuHistorial "1" --> "1" GestorClientes : gestor
Menu ..> Sesion : "usa (Singleton)"
MenuSolicitudes ..> Sesion : "usa (Singleton)"

' GestorClientes -> servicios delegados
GestorClientes "1" --> "1" Diccionario : "clientes\n<Integer, Cliente>"
GestorClientes "1" --> "1" IndiceClientes : indices
GestorClientes "1" --> "1" GestorRelaciones : gestorRelaciones
GestorClientes "1" --> "1" PersistenciaClientes : persistencia
GestorClientes ..> "0..*" Cliente : gestiona
GestorClientes ..> "1" Sesion : "usa (Singleton)"
GestorClientes ..> "0..*" Accion : crea

' IndiceClientes -> TDAs
IndiceClientes "1" --> "1" ABB : "indiceScoring\n<Int, Cola<Cliente>>"
IndiceClientes "1" --> "1" Diccionario : "indiceNombre\n<String, Cola<Cliente>>"

' GestorRelaciones -> TDAs (BFS)
GestorRelaciones ..> "0..*" Cliente : "gestiona relaciones"
GestorRelaciones ..> ABB : "construye arbol"
GestorRelaciones ..> Cola : "BFS: cola de recorrido"
GestorRelaciones ..> Diccionario : "BFS: visitados\n<Integer, Boolean>"

' Sesion -> servicios
Sesion "1" *-- "1" HistorialAcciones : historial

' HistorialAcciones -> TDA
HistorialAcciones "1" --> "1" Pila : "usa\n<Accion>"

' Cliente -> TDAs
Cliente "1" *-- "1" Cola : "solicitudesPendientes\n<SolicitudSeguimiento>"
Cliente "1" *-- "1" Diccionario : "siguiendo\n<Integer, Boolean>"
Cliente "1" *-- "1" Diccionario : "seguidores\n<Integer, Boolean>"
Cliente "1" *-- "1" Diccionario : "amistades\n<Integer, Boolean>"

' ==========================================
' GRAFOS IMPLICITOS (representacion conceptual)
' ==========================================

note as NGRAFOS
<b>GRAFOS — Representacion implicita con TDAs</b>

El sistema modela <b>dos grafos</b> superpuestos
sobre los mismos vertices (Clientes):

<b>1. Grafo DIRIGIDO de seguimientos</b>
   Vertices: N clientes (Diccionario principal)
   Aristas: Cliente.siguiendo (ida) + Cliente.seguidores (inversa)
   Implementacion: Diccionario<Integer, Boolean> por vertice
   = <b>Lista de adyacencia distribuida</b>
   Operaciones: seguir/dejarDeSeguir O(1), BFS O(V+E)

<b>2. Grafo NO DIRIGIDO de amistades (Iter 3)</b>
   Vertices: N clientes
   Aristas: Cliente.amistades (simetrica, ambos lados)
   Implementacion: Diccionario<Integer, Boolean> por vertice
   = <b>Lista de adyacencia distribuida</b>
   Invariante: A amigo de B <=> B amigo de A

<b>Algoritmo BFS (calcularDistancia)</b>
   Cola<Integer> = frontera por niveles
   Diccionario<Integer, Boolean> = conjunto visitados
   Recorre el grafo dirigido (siguiendo)
   Complejidad: O(V + E)
end note

' ==========================================
' TABLAS INFORMATIVAS (abajo)
' ==========================================

legend bottom
|= TDA |= Politica |= Quien lo usa |= Para que |= Complejidad |
| Diccionario<Int, Cliente> | Hash | GestorClientes | Indice primario de clientes por ID | insertar/obtener/eliminar: O(1) amort. |
| Diccionario<String, Cola> | Hash | IndiceClientes | Indice secundario por nombre | insertar/obtener: O(1) amort. |
| Diccionario<Int, Boolean> | Hash | Cliente | Lista de adyacencia: siguiendo (dirigido) | contiene/insertar/eliminar: O(1) amort. |
| Diccionario<Int, Boolean> | Hash | Cliente | Lista de adyacencia: seguidores (dirigido inverso) | contiene/insertar/eliminar: O(1) amort. |
| Diccionario<Int, Boolean> | Hash | Cliente | Lista de adyacencia: amistades (no dirigido, Iter 3) | contiene/insertar/eliminar: O(1) amort. |
| Diccionario<Int, Boolean> | Hash | GestorRelaciones | Conjunto de visitados en BFS (Iter 3) | contiene: O(1) amort. |
| ABB<Int, Cola<Cliente>> | BST | IndiceClientes | Indice por scoring (lazy loading, max 101 nodos) | insertar/buscar: O(log 101 + k) |
| ABB<Int, Cliente> | BST | GestorRelaciones | Arbol de relaciones (seguidores por scoring) | construir: O(k log k), nivel: O(N) |
| Pila<Accion> | LIFO | HistorialAcciones | Historial de acciones (undo) | apilar/desapilar: O(1) |
| Cola<SolicitudSeguimiento> | FIFO | Cliente | Solicitudes de seguimiento pendientes | encolar/desencolar: O(1) |
| Cola<Cliente> | FIFO | IndiceClientes | Agrupacion de clientes por scoring (nodo ABB) | encolar/desencolar: O(1) |
| Cola<Integer> | FIFO | GestorRelaciones | Recorrido BFS por niveles (Iter 3) | encolar/desencolar: O(1) |
| Conjunto | Set | tda | Elementos unicos (implementado sobre Diccionario) | agregar/contiene: O(1) amort. |

|= Grafo |= Tipo |= Vertices |= Aristas (lista de adyacencia) |= Algoritmos |= Complejidad |
| Seguimientos | Dirigido | Cliente (Diccionario principal) | siguiendo: Diccionario<Int,Bool> + seguidores (inversa) | BFS (calcularDistancia) | O(V+E) |
| Amistades (Iter 3) | No dirigido | Cliente (Diccionario principal) | amistades: Diccionario<Int,Bool> (simetrica) | agregar/eliminar/consultar | O(1) amort. |

|= Patron |= Implementacion |= Beneficio |
| Singleton | Sesion (unica instancia global) | Una sola sesion activa |
| Facade | GestorClientes (oculta complejidad interna) | API simplificada para la vista |
| Value Object | SolicitudSeguimiento (inmutable) | Integridad referencial |
| Command | HistorialAcciones (undo con Pila<Accion>) | Deshacer acciones SEGUIR/DEJAR_DE_SEGUIR |
| DIP | Cada TDA implementa su interfaz (IPila, ICola, etc.) | Depender de abstracciones, no de implementaciones |

|= Capa |= Color |= Clases |
| vista | Azul | Main, Menu, MenuSolicitudes, MenuHistorial, MenuUtils, Terminal |
| servicio | Verde | GestorClientes, GestorRelaciones, IndiceClientes, PersistenciaClientes, HistorialAcciones |
| modelo | Naranja | Cliente, Sesion, Accion, TipoAccion, SolicitudSeguimiento |
| tda | Violeta | Pila, Cola, Diccionario, ABB, Conjunto + nodos internos |

|= Relacion |= Simbolo |= Significado |
| Composicion | *-- | Parte vital (muere con el todo) |
| Agregacion | o-- | Parte referenciada (vive independientemente) |
| Asociacion | --> | Relacion estructural fuerte |
| Dependencia | ..> | Uso temporal ('usa', 'crea') |
end legend

@enduml
